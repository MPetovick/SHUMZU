{
  "name": "sembrado",
  "version": "0.0.1",
  "private": true,
  "description": "Estrategia por casillas para dos jugadores con órdenes simultáneas. PWA con PvP por WebRTC.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/ui/app.js --bundle --format=iife --target=es2020 --outfile=app.bundle.js --legal-comments=none",
    "start": "python3 -m http.server 8080",
    "test": "node --test tests/engine.test.mjs tests/session.test.mjs",
    "sim": "node tools/simulate.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
